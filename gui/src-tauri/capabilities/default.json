{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-stat",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$RESOURCE/app-icon.svg" }]
    },
    "updater:default"
  ]
}
